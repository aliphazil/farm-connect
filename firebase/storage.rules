rules_version = '2';

// FarmConnect Maldives — Cloud Storage Security Rules. Deny by default.
// Keep paths and limits in sync with shared/firestore-paths.ts
// (storagePaths, UPLOAD_LIMITS).
//
// Uploads require: a signed-in, non-blocked farmer whose users/{uid}.status is
// "active" (cross-service check against Firestore), writing under their own
// uid, with an allowed content type, a size limit and a safe file name.
//
// NOTE: the Firestore cross-service check needs a one-time permission grant
// in production (the Firebase console prompts for it when rules are deployed).
//
// Tests: tests/rules/storage.rules.test.ts  (npm run test:storage-rules)

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }
    function notBlocked() {
      return request.auth.token.get('blocked', false) != true;
    }
    function isAdmin() {
      return signedIn() && request.auth.token.get('role', '') == 'admin' && notBlocked();
    }
    function isActiveFarmer(ownerId) {
      return signedIn()
        && request.auth.uid == ownerId
        && request.auth.token.get('role', '') == 'farmer'
        && notBlocked()
        && firestore.get(/databases/(default)/documents/users/$(ownerId)).data.status == 'active';
    }
    function safeName(fileName) {
      return fileName.matches('^[A-Za-z0-9._-]{1,100}$');
    }
    function isImage() {
      return request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
    function isProof() {
      return request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)|application/pdf');
    }

    // Product photos: public to view, writable only by the owning farmer.
    match /products/{farmerId}/{productId}/{fileName} {
      allow read: if true;
      allow create, update: if isActiveFarmer(farmerId) && safeName(fileName) && isImage();
      allow delete: if isActiveFarmer(farmerId);
    }

    // Farm logos.
    match /farmers/{farmerId}/{fileName} {
      allow read: if true;
      allow create, update: if isActiveFarmer(farmerId) && safeName(fileName) && isImage();
      allow delete: if isActiveFarmer(farmerId);
    }

    // Payment proofs (transfer slips): private to the farmer and admins.
    // Immutable once uploaded so they remain trustworthy evidence.
    match /payments/{farmerId}/{paymentId}/{fileName} {
      allow read: if (signedIn() && request.auth.uid == farmerId) || isAdmin();
      // `resource == null`: only brand-new files; overwriting an existing proof is denied.
      allow create: if resource == null && isActiveFarmer(farmerId) && safeName(fileName) && isProof();
      allow update, delete: if false;
    }

    // Report evidence: private to the reporter and admins, write-once, so
    // it stays trustworthy. Any active farmer or buyer may upload; the
    // server checks each file again when the report is submitted.
    function isActiveMember(ownerId) {
      return signedIn()
        && request.auth.uid == ownerId
        && request.auth.token.get('role', '') in ['farmer', 'consumer']
        && notBlocked()
        && firestore.get(/databases/(default)/documents/users/$(ownerId)).data.status == 'active';
    }
    match /reportEvidence/{reporterId}/{fileName} {
      allow read: if (signedIn() && request.auth.uid == reporterId) || isAdmin();
      allow create: if resource == null && isActiveMember(reporterId) && safeName(fileName) && isProof();
      allow update, delete: if false;
    }

    // Site branding assets are uploaded by server code (Admin SDK) only.
    match /branding/{fileName} {
      allow read: if true;
      allow write: if false;
    }
    // Branding Studio uploads: owner-level admins only, raster images (no SVG,
    // which can carry script), small, write-once. Public to read, because
    // published images are shown to everyone; the server checks each file
    // again when a draft is saved.
    function isOwnerAdmin() {
      return isAdmin() && request.auth.token.get('adminLevel', '') == 'owner';
    }
    match /branding/uploads/{fileName} {
      allow read: if true;
      allow create: if resource == null && isOwnerAdmin() && safeName(fileName)
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|x-icon|vnd[.]microsoft[.]icon)');
      allow update, delete: if false;
    }
  }
}
