# FarmConnect Maldives — environment variables.
# Copy to .env.local and fill in. NEVER commit .env.local (it is git-ignored).
# Every value below is a placeholder. See docs/firebase-setup.md.

# --- Firebase web app config (public: shipped to the browser by design) ---
# Firebase console → Project settings → General → Your apps → Web app → Config.
# Security comes from Security Rules, not from hiding these values.
NEXT_PUBLIC_FIREBASE_API_KEY=your-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# "true" connects the browser SDK to the local emulators (npm run emulators).
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# --- Firebase Admin SDK (server only — SECRET) ---
# Firebase console → Project settings → Service accounts → Generate new private key.
# Copy the three values from the downloaded JSON, then delete the JSON file.
# Keep the \n sequences in the private key exactly as they appear in the JSON.
# On Firebase App Hosting / Cloud Run, leave all three empty: the runtime's
# own service account is used automatically (Application Default Credentials).
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# --- Local development against the emulators (instead of a real project) ---
# Uncomment all of these, set NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true and use
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-farmconnect (any non-empty web config
# values work with the emulators). The Admin SDK reads the *_EMULATOR_HOST vars.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# --- Public catalog source ---
# "sample" (default): bundled sample products, shown with a sample-data notice.
# "firestore": live products and farms from Firestore. Must also be set when
# building, because public pages are prerendered from the catalog.
CATALOG_SOURCE=sample
