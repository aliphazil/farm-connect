{
  "name": "farmer-connect",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run test",
    "emulators": "firebase emulators:start --project demo-farmconnect",
    "test:emulator": "firebase emulators:exec --only auth,firestore,storage --project demo-farmconnect \"vitest run -c vitest.emulator.config.mts\"",
    "test:storage-rules": "firebase emulators:exec --only firestore,storage --project demo-farmconnect \"vitest run -c vitest.emulator.config.mts tests/rules/storage.rules.test.ts\"",
    "seed:reference": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/seed-reference-data.mts",
    "admin:grant": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/grant-admin.mts",
    "islands:import": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/import-islands.mts"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "next": "16.4.2",
    "pdf-lib": "^1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-sans-thaana": "^5.3.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "firebase-tools": "^15.34.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
